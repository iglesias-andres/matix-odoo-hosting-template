# Copiar a .env y completar. .env NUNCA se commitea (agregarlo a .gitignore).

# --- Identificación del cliente ---
# Nombres de las bases de datos de Odoo (sin espacios, minúsculas). No confundir
# con POSTGRES_USER: esto es el nombre de la base "adentro" de Postgres.
PROD_DB=nombrecliente
STAGING_DB=nombrecliente_staging

# --- Dominios ---
# Dejar vacíos si todavía no hay dominio - ver README para el modo temporal por IP.
PROD_DOMAIN=cliente.tudominio.com
STAGING_DOMAIN=staging.cliente.tudominio.com

# --- Postgres (compartido por los contenedores odoo y odoo-staging) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CAMBIAR_POR_UN_PASSWORD_FUERTE

# --- Master password de Odoo (admin_passwd) ---
# Uno distinto por entorno. Es la contraseña que protege crear/borrar/duplicar
# bases desde /web/database/manager - no es la contraseña de ningún usuario.
ODOO_ADMIN_PASSWD_PROD=CAMBIAR_POR_UN_PASSWORD_FUERTE
ODOO_ADMIN_PASSWD_STAGING=CAMBIAR_POR_UN_PASSWORD_FUERTE

# --- Workers de producción ---
# 0 = modelo liviano (bueno para 1-3 usuarios concurrentes o etapa de desarrollo).
# 2 o más = modelo multi-proceso (bueno para uso real con varios usuarios a la vez).
# Staging siempre usa 0 (no compite por RAM con producción).
ODOO_WORKERS_PROD=0
